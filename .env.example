# ===========================================
# LIVE BEACON - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Discord Bot (Required)
DISCORD_TOKEN=

# Twitch API (Required for stream notifications)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Spotify API (Optional - enables Spotify song requests)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Twitch Chat Bot (Optional - enables !lbsr in Twitch chat)
# Get token from: https://twitchtokengenerator.com/
TWITCH_BOT_USERNAME=
TWITCH_BOT_TOKEN=
